<?xml version="1.0" encoding="UTF-8"?>

<suite name="CrossBrowser-Suite"
       parallel="tests"
       thread-count="3"
       data-provider-thread-count="1"
       verbose="1">

    <!-- Execute smoke scenarios on Chrome -->
    <test name="Chrome-Smoke">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="runners.TestRunner"/>
        </classes>
    </test>

    <!-- Execute smoke scenarios on Firefox -->
    <test name="Firefox-Smoke">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="runners.TestRunner"/>
        </classes>
    </test>

    <!-- Execute smoke scenarios on Edge -->
    <test name="Edge-Smoke">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="runners.TestRunner"/>
        </classes>
    </test>

</suite>